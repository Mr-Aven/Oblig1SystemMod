classDiagram
    class Lab {
        -Lab_Utstyr[0..*] utstyrsliste
        -Student[0..*] student_liste
        -Utlaan[0..*] utlaansliste
        +legg_til_utstyr(Lab_Utstyr utstyr) void
        +registrer_student(Student student) void
        +laan_ut(Student student, Lab_Utstyr utstyr) Utlaan
        +registrer_retur(Utlaan utlaan) void
        +finn_tilgjengelig_utstyr(Lab_Utstyr utstyr) Bool
    }

    class Lab_Utstyr {
        -string utstyr_navn
        -int antall_totalt
        -int antall_tilgjengelig
        +er_tilgjengelig() bool
        +oek_antall_tilgjengelig() void
        +reduser_antall_tilgjengelig() void
        +get_navn() string
    }

    class Student {
        -string studentnummer
        -string navn
        -Utlån[0..*] mine_laan
        +legg_til_laan(Utlaan) void
        +fjern_laan(Utlaan) void
        +get_laan() Utlaan[0..*]
    }

    class Utlaan {
        -Student laanetaker
        -Lab_Utstyr utlaant_utstyr
        -int antall
        +get_laanetaker() Student
        +get_utstyr() Lab_Utstyr
        +get_antall() int
    }

    Lab "1" o-- "0..*" Lab_Utstyr : utstyrsliste
    Lab "1" o-- "0..*" Student : student_liste
    Lab "1" *-- "0..*" Utlaan : utlaansliste
    Student "1" -- "0..*" Utlaan : mine_laan
    Utlaan "0..*" --> "1" Lab_Utstyr : utlaant_utstyr

    note for Student "Kildediagrammet skriver attributtypen som Utlån.\nAndre referanser bruker Utlaan; dette er ikke to klasser."
